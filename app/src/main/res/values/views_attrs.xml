<resources>
	<declare-styleable name="ProfilePictureView">
		<attr name="isInput" format="boolean" />
	</declare-styleable>

	<declare-styleable name="NavbarView">
		<attr name="professional" format="boolean" />
	</declare-styleable>

	<declare-styleable name="HeaderView">
		<attr name="headerType" format="enum">
			<enum name="compact" value="0" />
			<enum name="titled" value="1" />
		</attr>
		<attr name="isScreenTitled" format="boolean" />
	</declare-styleable>

	<declare-styleable name="FilterView">
		<attr name="isOrderByFilter" format="boolean" />
	</declare-styleable>

	<declare-styleable name="OptionItemView">
		<attr name="iconSrc" format="reference" />
		<attr name="text" format="string" />
		<attr name="hasArrow" format="boolean" />
		<attr name="color" format="color" />
	</declare-styleable>
</resources>