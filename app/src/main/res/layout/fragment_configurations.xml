<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:app="http://schemas.android.com/apk/res-auto"

	android:layout_width="match_parent"
	android:layout_height="match_parent"

	tools:context=".Configurations">

	<EditText
		android:id="@+id/search"

		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:autofillHints="name"
		android:background="@drawable/shape_search_background"
		android:backgroundTint="@color/primary"
		android:drawableStart="@drawable/ic_search"
		android:drawablePadding="10dp"
		android:drawableTint="@color/textLight"
		android:hint="@string/search"
		android:inputType="text"
		android:padding="15dp"
		android:textColor="@color/textLight"
		android:textColorHint="@color/textLight60"

		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<androidx.constraintlayout.widget.ConstraintLayout
		android:id="@+id/acessibility_data_layout"

		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/default_inner_elements_spacing"

		app:layout_constraintTop_toBottomOf="@id/search"
		app:layout_constraintStart_toStartOf="parent">

		<Button
			style="?attr/materialIconButtonStyle"

			android:id="@+id/minimize_acessibility_layout_button"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="10dp"
			android:rotation="90"

			app:icon="@drawable/ic_chevron_generic"
			app:iconSize="30dp"
			app:iconTint="@color/textLight"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/acessibility"
			android:textSize="20sp"

			app:layout_constraintStart_toEndOf="@id/minimize_acessibility_layout_button"
			app:layout_constraintTop_toTopOf="@id/minimize_acessibility_layout_button"
			app:layout_constraintBottom_toBottomOf="@id/minimize_acessibility_layout_button"/>


		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:background="@drawable/shape_rounded_background"
			android:backgroundTint="@color/surface"
			android:padding="@dimen/default_card_padding"
			android:showDividers="middle|end"
			android:divider="@drawable/divider_options_list"
			android:layout_marginTop="@dimen/default_inner_elements_spacing"

			app:layout_constraintTop_toBottomOf="@id/minimize_acessibility_layout_button">

			<com.unnebulous.consultapronta.views.SelectOptionItemView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:focusable="true"
				android:clickable="true"

				app:selectOptionType="complete"
				app:textColor="@color/textDark"
				app:completeLayoutIcon="@drawable/ic_info"
				app:selectText="Tema"
				app:selectSubtitleText="Modos escuro e claro">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"

					android:text="@string/placeholder"
					android:textColor="@color/textDark"
					/>
			</com.unnebulous.consultapronta.views.SelectOptionItemView>

			<com.unnebulous.consultapronta.views.OptionItemView
				android:id="@+id/font_size"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:text="Tamanho da Fonte"
				app:iconSrc="@drawable/ic_text"
				/>

			<com.unnebulous.consultapronta.views.SelectOptionItemView
				android:id="@+id/contrast_option"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"

				app:completeLayoutIcon="@drawable/ic_contrast"
				app:selectOptionType="complete"
				app:selectText="Alto Contraste"
				app:textColor="@color/textDark">

				<androidx.appcompat.widget.SwitchCompat
					android:id="@+id/switch_contrast"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"

					app:switchMinWidth="60dp"
					app:thumbTint="@color/textLight"
					app:track="@drawable/shape_switch_background"
					app:trackTint="@color/switch_color" />
			</com.unnebulous.consultapronta.views.SelectOptionItemView>

			<com.unnebulous.consultapronta.views.SelectOptionItemView
				android:id="@+id/bold_option"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"

				app:completeLayoutIcon="@drawable/ic_bold"
				app:selectOptionType="complete"
				app:selectText="Texto em Negrito"
				app:textColor="@color/textDark">

				<androidx.appcompat.widget.SwitchCompat
					android:id="@+id/switch_bold"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"

					app:switchMinWidth="60dp"
					app:thumbTint="@color/textLight"
					app:track="@drawable/shape_switch_background"
					app:trackTint="@color/switch_color" />
			</com.unnebulous.consultapronta.views.SelectOptionItemView>

		</LinearLayout>
	</androidx.constraintlayout.widget.ConstraintLayout>

	<androidx.constraintlayout.widget.ConstraintLayout
		android:id="@+id/safety_data_layout"

		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/default_inner_elements_spacing"

		app:layout_constraintTop_toBottomOf="@id/acessibility_data_layout"
		app:layout_constraintStart_toStartOf="parent">

		<Button
			style="?attr/materialIconButtonStyle"

			android:id="@+id/minimize_safety_layout_button"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:padding="10dp"
			android:rotation="90"

			app:icon="@drawable/ic_chevron_generic"
			app:iconSize="30dp"
			app:iconTint="@color/textLight"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/safety"
			android:textSize="20sp"

			app:layout_constraintStart_toEndOf="@id/minimize_safety_layout_button"
			app:layout_constraintTop_toTopOf="@id/minimize_safety_layout_button"
			app:layout_constraintBottom_toBottomOf="@id/minimize_safety_layout_button"/>

		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/safety_layout"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/shape_rounded_background"
			android:padding="@dimen/default_card_padding"
			android:backgroundTint="@color/surface"
			android:layout_marginTop="@dimen/default_inner_elements_spacing"

			app:layout_constraintTop_toBottomOf="@id/minimize_safety_layout_button">

			<LinearLayout
				android:id="@+id/basic_account_info_layout"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:showDividers="middle|end"
				android:divider="@drawable/divider_options_list"
				android:dividerPadding="2dp"
				android:orientation="vertical"

				app:layout_constraintTop_toTopOf="parent">
				<com.unnebulous.consultapronta.views.OptionItemView
					android:id="@+id/alter_password"

					android:layout_width="match_parent"
					android:layout_height="wrap_content"

					app:iconSrc="@drawable/ic_password_lock"

					tools:text="Alterar Senha" />

				<com.unnebulous.consultapronta.views.OptionItemView
					android:id="@+id/two_factor_auth"

					android:layout_width="match_parent"
					android:layout_height="wrap_content"

					app:iconSrc="@drawable/ic_shield_person"

					tools:text="Autenticação por 2 Fatores" />

			</LinearLayout>
		</androidx.constraintlayout.widget.ConstraintLayout>
	</androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>