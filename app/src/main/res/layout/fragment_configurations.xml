<?xml version="1.0" encoding="utf-8"?>
<ScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:app="http://schemas.android.com/apk/res-auto"

	android:layout_width="match_parent"
	android:layout_height="match_parent"

	tools:context=".Configurations">

	<androidx.constraintlayout.widget.ConstraintLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content">

		<EditText
			android:id="@+id/search"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:autofillHints="name"
			android:background="@drawable/shape_search_background"
			android:backgroundTint="@color/primary"
			android:drawableStart="@drawable/ic_search"
			android:drawablePadding="10dp"
			android:drawableTint="@color/textLight"
			android:hint="@string/search"
			android:inputType="text"
			android:padding="15dp"
			android:textColor="@color/textLight"
			android:textColorHint="@color/textLight60"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent" />

		<!-- ACESSIBILIDADE -->
		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/acessibility_data_layout"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/default_inner_elements_spacing"

			app:layout_constraintTop_toBottomOf="@id/search"
			app:layout_constraintStart_toStartOf="parent">

			<Button
				style="?attr/materialIconButtonStyle"

				android:id="@+id/minimize_acessibility_layout_button"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="10dp"
				android:rotation="90"

				app:icon="@drawable/ic_chevron_generic"
				app:iconSize="30dp"
				app:iconTint="@color/textLight"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/acessibility"
				android:textSize="20sp"

				app:layout_constraintStart_toEndOf="@id/minimize_acessibility_layout_button"
				app:layout_constraintTop_toTopOf="@id/minimize_acessibility_layout_button"
				app:layout_constraintBottom_toBottomOf="@id/minimize_acessibility_layout_button" />

			<LinearLayout
				android:id="@+id/accessibility_options"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:background="@drawable/shape_rounded_background"
				android:backgroundTint="@color/surface"
				android:padding="@dimen/default_card_padding"
				android:showDividers="middle"
				android:divider="@drawable/divider_options_list"
				android:layout_marginTop="@dimen/default_inner_elements_spacing"

				app:layout_constraintTop_toBottomOf="@id/minimize_acessibility_layout_button">

				<com.unnebulous.consultapronta.views.SelectOptionItemView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:focusable="true"
					android:clickable="true"

					app:selectOptionType="complete"
					app:textColor="@color/textDark"
					app:completeLayoutIcon="@drawable/ic_info"
					app:selectText="Tema"
					app:selectSubtitleText="Modos escuro e claro">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/placeholder"
						android:textColor="@color/textDark" />

				</com.unnebulous.consultapronta.views.SelectOptionItemView>

				<com.unnebulous.consultapronta.views.OptionItemView
					android:id="@+id/font_size"

					android:layout_width="match_parent"
					android:layout_height="wrap_content"

					app:text="Tamanho da Fonte"
					app:iconSrc="@drawable/ic_text" />

				<com.unnebulous.consultapronta.views.SelectOptionItemView
					android:id="@+id/contrast_option"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"

					app:completeLayoutIcon="@drawable/ic_contrast"
					app:selectOptionType="complete"
					app:selectText="Alto Contraste"
					app:textColor="@color/textDark">

					<androidx.appcompat.widget.SwitchCompat
						android:id="@+id/switch_contrast"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"

						app:switchMinWidth="60dp"
						app:thumbTint="@color/textLight"
						app:track="@drawable/shape_switch_background"
						app:trackTint="@color/switch_color" />

				</com.unnebulous.consultapronta.views.SelectOptionItemView>

				<com.unnebulous.consultapronta.views.SelectOptionItemView
					android:id="@+id/bold_option"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"

					app:completeLayoutIcon="@drawable/ic_bold"
					app:selectOptionType="complete"
					app:selectText="Texto em Negrito"
					app:textColor="@color/textDark">

					<androidx.appcompat.widget.SwitchCompat
						android:id="@+id/switch_bold"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"

						app:switchMinWidth="60dp"
						app:thumbTint="@color/textLight"
						app:track="@drawable/shape_switch_background"
						app:trackTint="@color/switch_color" />

				</com.unnebulous.consultapronta.views.SelectOptionItemView>

			</LinearLayout>
		</androidx.constraintlayout.widget.ConstraintLayout>

		<!-- SEGURANÇA -->
		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/safety_data_layout"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/default_inner_elements_spacing"

			app:layout_constraintTop_toBottomOf="@id/acessibility_data_layout"
			app:layout_constraintStart_toStartOf="parent">

			<Button
				style="?attr/materialIconButtonStyle"

				android:id="@+id/minimize_safety_layout_button"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="10dp"
				android:rotation="90"

				app:icon="@drawable/ic_chevron_generic"
				app:iconSize="30dp"
				app:iconTint="@color/textLight"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/safety"
				android:textSize="20sp"

				app:layout_constraintStart_toEndOf="@id/minimize_safety_layout_button"
				app:layout_constraintTop_toTopOf="@id/minimize_safety_layout_button"
				app:layout_constraintBottom_toBottomOf="@id/minimize_safety_layout_button" />

			<LinearLayout
				android:id="@+id/basic_account_info_layout"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@drawable/shape_rounded_background"
				android:backgroundTint="@color/surface"
				android:showDividers="middle"
				android:divider="@drawable/divider_options_list"
				android:dividerPadding="2dp"
				android:padding="@dimen/default_card_padding"
				android:orientation="vertical"

				app:layout_constraintTop_toBottomOf="@id/minimize_safety_layout_button">

				<com.unnebulous.consultapronta.views.OptionItemView
					android:id="@+id/alter_password"

					android:layout_width="match_parent"
					android:layout_height="wrap_content"

					app:iconSrc="@drawable/ic_password_lock"
					app:text="Alterar Senha" />

				<com.unnebulous.consultapronta.views.OptionItemView
					android:id="@+id/two_factor_auth"

					android:layout_width="match_parent"
					android:layout_height="wrap_content"

					app:iconSrc="@drawable/ic_shield_person"
					app:text="Autenticação por 2 Fatores" />

			</LinearLayout>
		</androidx.constraintlayout.widget.ConstraintLayout>

		<!-- NOTIFICAÇÕES -->
		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/notifications_data_layout"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/default_inner_elements_spacing"

			app:layout_constraintTop_toBottomOf="@id/safety_data_layout"
			app:layout_constraintStart_toStartOf="parent">

			<Button
				style="?attr/materialIconButtonStyle"

				android:id="@+id/minimize_notifications_layout_button"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="10dp"
				android:rotation="90"

				app:icon="@drawable/ic_chevron_generic"
				app:iconSize="30dp"
				app:iconTint="@color/textLight"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/notifications"
				android:textSize="20sp"

				app:layout_constraintStart_toEndOf="@id/minimize_notifications_layout_button"
				app:layout_constraintTop_toTopOf="@id/minimize_notifications_layout_button"
				app:layout_constraintBottom_toBottomOf="@id/minimize_notifications_layout_button" />

			<LinearLayout
				android:id="@+id/notifications_options_layout"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:background="@drawable/shape_rounded_background"
				android:backgroundTint="@color/surface"
				android:padding="@dimen/default_card_padding"
				android:showDividers="middle"
				android:divider="@drawable/divider_options_list"
				android:layout_marginTop="@dimen/default_inner_elements_spacing"

				app:layout_constraintTop_toBottomOf="@id/minimize_notifications_layout_button">

				<com.unnebulous.consultapronta.views.SelectOptionItemView
					android:id="@+id/push_option"

					android:layout_width="match_parent"
					android:layout_height="wrap_content"

					app:completeLayoutIcon="@drawable/ic_mobile"
					app:selectOptionType="complete"
					app:selectText="Push"
					app:selectSubtitleText="Receba alertas na tela do seu celular"
					app:textColor="@color/textDark">

					<androidx.appcompat.widget.SwitchCompat
						android:id="@+id/switch_push"

						android:layout_width="wrap_content"
						android:layout_height="wrap_content"

						app:switchMinWidth="60dp"
						app:thumbTint="@color/textLight"
						app:track="@drawable/shape_switch_background"
						app:trackTint="@color/switch_color" />

				</com.unnebulous.consultapronta.views.SelectOptionItemView>

				<com.unnebulous.consultapronta.views.SelectOptionItemView
					android:id="@+id/email_option"

					android:layout_width="match_parent"
					android:layout_height="wrap_content"

					app:completeLayoutIcon="@drawable/ic_email"
					app:selectOptionType="complete"
					app:selectText="@string/input_email"
					app:selectSubtitleText="Receba resumos e alertas por email"
					app:textColor="@color/textDark">

					<androidx.appcompat.widget.SwitchCompat
						android:id="@+id/switch_email"

						android:layout_width="wrap_content"
						android:layout_height="wrap_content"

						app:switchMinWidth="60dp"
						app:thumbTint="@color/textLight"
						app:track="@drawable/shape_switch_background"
						app:trackTint="@color/switch_color" />

				</com.unnebulous.consultapronta.views.SelectOptionItemView>

				<com.unnebulous.consultapronta.views.SelectOptionItemView
					android:id="@+id/sms_option"

					android:layout_width="match_parent"
					android:layout_height="wrap_content"

					app:completeLayoutIcon="@drawable/ic_sms"
					app:selectOptionType="complete"
					app:selectText="SMS"
					app:selectSubtitleText="Receba resumos e alertas por SMS"
					app:textColor="@color/textDark">

					<androidx.appcompat.widget.SwitchCompat
						android:id="@+id/switch_sms"

						android:layout_width="wrap_content"
						android:layout_height="wrap_content"

						app:switchMinWidth="60dp"
						app:thumbTint="@color/textLight"
						app:track="@drawable/shape_switch_background"
						app:trackTint="@color/switch_color" />

				</com.unnebulous.consultapronta.views.SelectOptionItemView>

			</LinearLayout>
		</androidx.constraintlayout.widget.ConstraintLayout>

		<!-- LEMBRETES -->
		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/alerts_data_layout"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/default_inner_elements_spacing"

			app:layout_constraintTop_toBottomOf="@id/notifications_data_layout"
			app:layout_constraintStart_toStartOf="parent">

			<Button
				style="?attr/materialIconButtonStyle"

				android:id="@+id/minimize_alerts_layout_button"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="10dp"
				android:rotation="90"

				app:icon="@drawable/ic_chevron_generic"
				app:iconSize="30dp"
				app:iconTint="@color/textLight"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/reminders"
				android:textSize="20sp"

				app:layout_constraintStart_toEndOf="@id/minimize_alerts_layout_button"
				app:layout_constraintTop_toTopOf="@id/minimize_alerts_layout_button"
				app:layout_constraintBottom_toBottomOf="@id/minimize_alerts_layout_button" />

			<LinearLayout
				android:id="@+id/reminders_options_layout"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:background="@drawable/shape_rounded_background"
				android:backgroundTint="@color/surface"
				android:padding="@dimen/default_card_padding"
				android:showDividers="middle"
				android:divider="@drawable/divider_options_list"
				android:layout_marginTop="@dimen/default_inner_elements_spacing"

				app:layout_constraintTop_toBottomOf="@id/minimize_alerts_layout_button">

				<com.unnebulous.consultapronta.views.SelectOptionItemView
					android:id="@+id/medications_option"

					android:layout_width="match_parent"
					android:layout_height="wrap_content"

					app:completeLayoutIcon="@drawable/ic_medication"
					app:selectOptionType="complete"
					app:selectText="Lembrete de Medicamentos"
					app:selectSubtitleText="Seja notificado ao chegar a hora de tomar medicamentos"
					app:textColor="@color/textDark">

					<androidx.appcompat.widget.SwitchCompat
						android:id="@+id/switch_medications"

						android:layout_width="wrap_content"
						android:layout_height="wrap_content"

						app:switchMinWidth="60dp"
						app:thumbTint="@color/textLight"
						app:track="@drawable/shape_switch_background"
						app:trackTint="@color/switch_color" />

				</com.unnebulous.consultapronta.views.SelectOptionItemView>

				<com.unnebulous.consultapronta.views.SelectOptionItemView
					android:id="@+id/new_consultations_option"

					android:layout_width="match_parent"
					android:layout_height="wrap_content"

					app:completeLayoutIcon="@drawable/ic_calendar"
					app:selectOptionType="complete"
					app:selectText="Lembrete de Consultas"
					app:selectSubtitleText="Seja notificado previamente sobre consultas marcadas"
					app:textColor="@color/textDark">

					<androidx.appcompat.widget.SwitchCompat
						android:id="@+id/switch_consultations"

						android:layout_width="wrap_content"
						android:layout_height="wrap_content"

						app:switchMinWidth="60dp"
						app:thumbTint="@color/textLight"
						app:track="@drawable/shape_switch_background"
						app:trackTint="@color/switch_color" />

				</com.unnebulous.consultapronta.views.SelectOptionItemView>

				<com.unnebulous.consultapronta.views.SelectOptionItemView
					android:id="@+id/report_option"

					android:layout_width="match_parent"
					android:layout_height="wrap_content"

					app:completeLayoutIcon="@drawable/ic_reports"
					app:selectOptionType="complete"
					app:selectText="Acesso a Relatórios"
					app:selectSubtitleText="Seja notificado quando um médico acessar seu relatório"
					app:textColor="@color/textDark">

					<androidx.appcompat.widget.SwitchCompat
						android:id="@+id/switch_report"

						android:layout_width="wrap_content"
						android:layout_height="wrap_content"

						app:switchMinWidth="60dp"
						app:thumbTint="@color/textLight"
						app:track="@drawable/shape_switch_background"
						app:trackTint="@color/switch_color" />

				</com.unnebulous.consultapronta.views.SelectOptionItemView>

			</LinearLayout>
		</androidx.constraintlayout.widget.ConstraintLayout>

	</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
