<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background"
    >

    <ImageButton
        android:id="@+id/return_button"

        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:background="transparent"
        android:src="@drawable/arrow_back"

        android:contentDescription="TODO"

        android:layout_marginTop="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/return_text"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/return_text"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="25sp"
        android:fontFamily="@font/nunito_sans"

        app:layout_constraintStart_toEndOf="@id/return_button"
        app:layout_constraintTop_toTopOf="@id/return_button"

        android:layout_marginStart="0dp" />

    <TextView
        android:id="@+id/welcome"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome"
        android:textColor="@color/white"
        android:textSize="25sp"
        android:textStyle="bold"
        android:fontFamily="@font/nunito_sans"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/return_text"
        android:layout_marginStart="25dp"
        android:layout_marginTop="15dp" />

    <TextView
        android:id="@+id/info_text"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/info_text"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:fontFamily="@font/nunito_sans"

        app:layout_constraintStart_toStartOf="@id/welcome"
        app:layout_constraintTop_toBottomOf="@id/welcome"
        android:layout_marginTop="10dp" />
    
    <LinearLayout
        android:id="@+id/user_type"

        android:layout_width="0dp"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="@color/container"
        android:padding="8dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/info_text"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:layout_marginTop="35dp">

        <TextView
            android:id="@+id/patient"

            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"

            android:fontFamily="@font/nunito_sans"
            android:text="@string/sou_paciente"
            android:textColor="@color/container"
            android:background="@drawable/selection_button_indicative" />

        <TextView
            android:id="@+id/professional"

            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:fontFamily="@font/nunito_sans"

            android:text="@string/sou_profissional"
            android:textColor="@color/beige" />

    </LinearLayout>

    <TextView
        android:id="@+id/govlogin"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/govlogin"
        android:textColor="@color/beige"
        android:textStyle="bold"
        android:fontFamily="@font/nunito_sans"

        app:layout_constraintTop_toBottomOf="@id/user_type"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp" />

    <EditText
        android:id="@+id/input_email"

        android:layout_width="0dp"
        android:layout_height="50dp"

        android:hint="@string/email_hint"
        android:textColorHint="@color/light_gray"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:background="@color/input_box"
        android:inputType="textEmailAddress"
        android:drawableStart="@drawable/email_ic"

        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:drawablePadding="10dp"

        app:layout_constraintTop_toBottomOf="@id/govlogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginTop="15dp" />

    <EditText
        android:id="@+id/input_pass"

        android:layout_width="0dp"
        android:layout_height="50dp"

        android:hint="@string/password_hint"
        android:textColorHint="@color/light_gray"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:background="@color/input_box"
        android:inputType="textPassword"
        android:drawableStart="@drawable/lock_ic"

        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:drawablePadding="10dp"

        app:layout_constraintTop_toBottomOf="@id/input_email"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/forgotpass"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/forgot_pass"
        android:textColor="@color/beige"
        android:textSize="15sp"

        app:layout_constraintEnd_toEndOf="@id/input_pass"
        app:layout_constraintTop_toBottomOf="@id/input_pass"
        android:layout_marginTop="10dp"
        />
    
    <Button
        android:id="@+id/enterbutton"

        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="@string/enter"
        android:textColor="@color/background"
        android:textSize="16sp"
        android:background="@drawable/enter_button"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="50dp"
        />

    <TextView
        android:id="@+id/createacc"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/createacc"
        android:textColor="@color/beige"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/enterbutton"
        android:layout_marginTop="10dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>