<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"

	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:paddingTop="@dimen/default_padding_top">

	<Button
		style="?attr/materialIconButtonStyle"

		android:id="@+id/go_back"

		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:padding="10dp"

		app:icon="@drawable/ic_arrow_back"
		app:iconSize="34dp"
		app:iconTint="@color/textLight"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent"/>

	<TextView
		android:id="@+id/header_title"

		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/go_back"
		android:textSize="26sp"
		android:textStyle="bold"

		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toEndOf="@id/go_back" />

	<TextView
		android:id="@+id/header_main_title"

		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginStart="@dimen/default_screen_padding"
		android:textSize="@dimen/default_header_text_size"
		android:textStyle="bold"
		android:visibility="gone"
		android:paddingBottom="@dimen/default_header_text_bottom_padding"

		app:layout_constraintTop_toBottomOf="@id/go_back"
		app:layout_constraintStart_toStartOf="parent"

		tools:text="@string/placeholder"
		tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>