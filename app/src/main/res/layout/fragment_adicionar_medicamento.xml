<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"

	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:showDividers="middle"
	android:divider="@drawable/divider_default"

	tools:context=".AdicionarMedicamento">

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/medication_name"
		android:textSize="20sp" />

	<EditText
		android:id="@+id/medication_name_input"

		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/shape_input"
		android:backgroundTint="@color/surface"
		android:hint="@string/medication_name_hint"
		android:inputType="text"
		android:autofillHints="name"
		android:textColor="@color/textDark"
		android:textColorHint="@color/textDark60" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/type_consumption"
		android:textSize="20sp" />

	<com.google.android.material.textfield.TextInputLayout
		style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

		android:id="@+id/type_consumption_dropdown"

		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:textColorHint="@color/textDark"

		app:hintEnabled="false"
		app:boxCornerRadiusTopStart="12dp"
		app:boxCornerRadiusTopEnd="12dp"
		app:boxCornerRadiusBottomStart="12dp"
		app:boxCornerRadiusBottomEnd="12dp"
		app:boxBackgroundColor="@color/surface"
		app:counterTextColor="@color/textDark"
		app:counterOverflowTextColor="@color/textDark"
		app:endIconMode="custom"
		app:endIconDrawable="@drawable/ic_arrow_down"
		app:endIconTint="@color/primaryDark">

		<com.google.android.material.textfield.MaterialAutoCompleteTextView
			android:id="@+id/type_consumption_select"

			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:hint="@string/type_consumption_hint"
			android:textColorHint="@color/textDark60"
			android:inputType="textAutoComplete"
			android:textColor="@color/textDark"
			android:padding="@dimen/default_card_padding" />

	</com.google.android.material.textfield.TextInputLayout>

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/usage_time"
		android:textSize="20sp" />

	<Button
		android:id="@+id/usage_time_input"

		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/time_not_selected"
		android:textAlignment="viewStart"
		android:textColor="@color/textDark60"
		android:padding="@dimen/default_card_padding"
		android:insetTop="0dp"
		android:insetBottom="0dp"

		app:icon="@drawable/ic_clock"
		app:iconSize="30dp"
		app:iconGravity="end"
		app:iconTint="@color/textDark60"
		app:backgroundTint="@color/surface"
		app:cornerRadius="@dimen/big_button_corner_radius"/>

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/photo"
		android:textSize="20sp" />

	<com.unnebulous.consultapronta.views.FileInputView
		android:id="@+id/file_input"

		android:layout_width="match_parent"
		android:layout_height="wrap_content"

		app:icon="@drawable/ic_camera"
		app:textMain="@string/photo_or_annex"
		app:inputMode="getFile" />

	<Button
		android:id="@+id/register_medication_button"

		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/register_medication"
		android:textColor="@color/primaryDark"
		android:insetBottom="0dp"

		app:backgroundTint="@color/accent"
		app:cornerRadius="@dimen/big_button_corner_radius" />

</LinearLayout>