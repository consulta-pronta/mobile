<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"

	android:orientation="horizontal"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="center_vertical"
	android:background="@drawable/shape_rounded_background"
	android:backgroundTint="@color/primary"
	android:padding="@dimen/default_card_padding">

	<androidx.appcompat.widget.AppCompatImageView
		android:layout_width="50dp"
		android:layout_height="50dp"
		android:src="@drawable/ic_reports"
		android:tint="@color/primaryDark"
		android:background="@drawable/shape_circle_accent"
		android:backgroundTint="@color/surface"
		android:padding="10dp"
		android:layout_marginEnd="@dimen/default_inner_elements_spacing" />

	<androidx.constraintlayout.widget.ConstraintLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		>

		<TextView
			android:id="@+id/report_card_period_prefix"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/report_card_period"
			android:textStyle="bold"
			android:layout_marginTop="5dp"
			android:textSize="14sp"

			app:layout_constraintTop_toBottomOf="@id/report_card_title"
			app:layout_constraintStart_toStartOf="@id/report_card_title"/>

		<TextView
			android:id="@+id/report_card_date_prefix"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="5dp"
			android:text="@string/report_card_added_in"
			android:textSize="14sp"

			app:layout_constraintTop_toBottomOf="@id/report_card_period_prefix"
			app:layout_constraintStart_toStartOf="@id/report_card_title"/>

		<TextView
			android:id="@+id/report_card_date"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="5dp"
			android:text="@string/placeholder_date"
			android:textSize="14sp"

			app:layout_constraintStart_toEndOf="@id/report_card_date_prefix"
			app:layout_constraintTop_toBottomOf="@id/report_card_period_prefix" />

		<TextView
			android:id="@+id/report_card_title"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textSize="20sp"

			tools:text="@string/placeholder"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent"/>

		<TextView
			android:id="@+id/report_card_period"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textSize="14sp"

			app:layout_constraintTop_toTopOf="@id/report_card_period_prefix"
			app:layout_constraintBottom_toBottomOf="@id/report_card_period_prefix"
			app:layout_constraintStart_toEndOf="@id/report_card_period_prefix"

			tools:text="@string/report_card_period_placeholder" />

	</androidx.constraintlayout.widget.ConstraintLayout>

	<Space
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:layout_weight="1" />

	<Button
		style="?attr/materialIconButtonStyle"

		android:id="@+id/options_button"

		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingLeft="0dp"
		android:paddingTop="0dp"
		android:paddingRight="0dp"
		android:paddingBottom="0dp"
		android:rotation="90"

		app:icon="@drawable/ic_more_three_dots"
		app:iconSize="45dp"
		app:iconTint="@color/accent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

</LinearLayout>