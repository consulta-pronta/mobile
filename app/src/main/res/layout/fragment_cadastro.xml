<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"

	android:layout_width="match_parent"
	android:layout_height="match_parent" >

	<com.unnebulous.consultapronta.views.HeaderView
		android:id="@+id/header"

		android:layout_width="match_parent"
		android:layout_height="wrap_content"

		app:headerType="titled"
		app:isScreenTitled="false"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:paddingStart="@dimen/default_screen_padding"
		android:paddingEnd="@dimen/default_screen_padding"
		android:paddingBottom="@dimen/default_screen_padding"

		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/header">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:showDividers="middle"
			android:divider="@drawable/divider_default" >

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/create_account"
				android:textSize="28sp"
				android:textStyle="bold" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/input_your_data" />


			<com.unnebulous.consultapronta.views.UserTypeSelectorView
				android:id="@+id/user_type_switch"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center_horizontal" />

			<com.unnebulous.consultapronta.views.ProfilePictureView
				android:id="@+id/profile_picture_input"

				android:layout_width="90dp"
				android:layout_height="90dp"
				android:layout_gravity="center_horizontal"

				app:isInput="true" />

			<EditText
				android:id="@+id/name_input"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:autofillHints="name"
				android:background="@drawable/shape_input"
				android:drawableStart="@drawable/ic_person"
				android:drawablePadding="10dp"
				android:hint="@string/input_name"
				android:inputType="text"

				android:textColor="@color/textLight"
				android:textColorHint="@color/textLight60" />

			<!-- Verificar autofillhint de CPF -->
			<EditText
				android:id="@+id/cpf_input"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:autofillHints=""
				android:background="@drawable/shape_input"
				android:drawableStart="@drawable/ic_document"
				android:drawablePadding="10dp"
				android:hint="@string/input_cpf"
				android:inputType="text"

				android:textColor="@color/textLight"
				android:textColorHint="@color/textLight60" />

			<EditText
				android:id="@+id/email_input"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:autofillHints="emailAddress"
				android:background="@drawable/shape_input"
				android:drawableStart="@drawable/ic_email"
				android:drawablePadding="10dp"
				android:hint="@string/input_email"
				android:inputType="textEmailAddress"

				android:textColor="@color/textLight"
				android:textColorHint="@color/textLight60" />

			<EditText
				android:id="@+id/phone_number_input"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:autofillHints="phone"
				android:background="@drawable/shape_input"
				android:drawableStart="@drawable/ic_telephone"
				android:drawablePadding="10dp"
				android:hint="@string/input_phone_number"
				android:inputType="phone"

				android:textColor="@color/textLight"
				android:textColorHint="@color/textLight60" />

			<LinearLayout
				android:id="@+id/password_errors_layout"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:visibility="gone"

				tools:visibility="visible" >
				<TextView
					android:id="@+id/password_error_length"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="@color/error"
					android:text="@string/password_length_error"
					android:drawablePadding="@dimen/default_drawable_icon_padding"

					app:drawableStartCompat="@drawable/ic_error_circle"
					app:drawableTint="@color/error" />

				<TextView
					android:id="@+id/password_error_caps"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="@color/error"
					android:text="@string/password_caps_error"
					android:drawablePadding="@dimen/default_drawable_icon_padding"

					app:drawableStartCompat="@drawable/ic_error_circle"
					app:drawableTint="@color/error" />

				<TextView
					android:id="@+id/password_error_numbers"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="@color/error"
					android:text="@string/password_numbers_error"
					android:drawablePadding="@dimen/default_drawable_icon_padding"

					app:drawableStartCompat="@drawable/ic_error_circle"
					app:drawableTint="@color/error" />
			</LinearLayout>

			<EditText
				android:id="@+id/password_input"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:autofillHints="password"
				android:background="@drawable/shape_input"
				android:drawableStart="@drawable/ic_password_lock"
				android:maxLength="4096"
				android:drawablePadding="10dp"
				android:hint="@string/input_password"
				android:inputType="textPassword"
				android:textColor="@color/textLight"
				android:textColorHint="@color/textLight60" />

			<EditText
				android:id="@+id/confirm_password_input"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:autofillHints="password"
				android:background="@drawable/shape_input"
				android:drawableStart="@drawable/ic_password_lock"
				android:drawablePadding="10dp"
				android:hint="@string/input_password_confirm"
				android:inputType="textPassword"

				android:textColor="@color/textLight"
				android:textColorHint="@color/textLight60" />


			<Button
				style="@style/Widget.Material3.Button.TextButton"

				android:id="@+id/send_crm_button"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/send_crm"
				android:textColor="@color/accent"
				android:visibility="gone"

				app:icon="@drawable/ic_document"
				app:iconGravity="textStart"
				app:iconSize="30dp"
				app:iconTint="@color/accent"

				tools:visibility="visible" />

			<Button
				android:id="@+id/create_account_button"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/create_account"
				android:textColor="@color/primaryDark"
				android:insetBottom="0dp"

				app:backgroundTint="@color/accent"
				app:cornerRadius="@dimen/big_button_corner_radius" />

			<Button
				android:id="@+id/login_govbr_button"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center_horizontal"
				android:text="@string/enter_with_govbr"
				android:textColor="@color/govbr_blue"

				app:backgroundTint="@color/white"
				app:icon="@drawable/ic_govbr_negativo"
				app:iconGravity="textEnd"
				app:iconSize="0dp"
				app:iconTint="@color/govbr_blue" />

			<!-- linha do checkbox -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:orientation="horizontal">

				<CheckBox
					android:id="@+id/terms_checkbox"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"

					app:buttonTint="@color/textLight"
					app:buttonIconTint="@color/checkbox_color" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/terms_part1"
					android:textSize="12sp" />

				<Button
					style="@style/Widget.Material3.Button.TextButton"

					android:id="@+id/use_terms_button"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingLeft="5dp"
					android:paddingTop="0dp"
					android:paddingRight="5dp"
					android:paddingBottom="0dp"
					android:text="@string/terms_of_use"
					android:textColor="@color/accent"
					android:textSize="12sp" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/terms_part2"
					android:textSize="12sp" />

				<Button
					style="@style/Widget.Material3.Button.TextButton"

					android:id="@+id/privacy_policy_button"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingLeft="5dp"
					android:paddingTop="0dp"
					android:paddingRight="5dp"
					android:paddingBottom="0dp"
					android:text="@string/privacy_policy"
					android:textColor="@color/accent"
					android:textSize="12sp" />

			</LinearLayout>

			<!-- linha do já possui conta -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:orientation="horizontal">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/has_account" />

				<Button
					style="@style/Widget.Material3.Button.TextButton"

					android:id="@+id/sign_in_button"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingLeft="5dp"
					android:paddingTop="0dp"
					android:paddingRight="5dp"
					android:paddingBottom="0dp"
					android:text="@string/sign_in"
					android:textColor="@color/accent" />

			</LinearLayout>

		</LinearLayout>

	</ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>