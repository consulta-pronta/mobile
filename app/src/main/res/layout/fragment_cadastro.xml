<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"

	android:layout_width="match_parent"
	android:layout_height="match_parent" >

	<com.unnebulous.consultapronta.views.HeaderView
		android:id="@+id/header"

		android:layout_width="match_parent"
		android:layout_height="wrap_content"

		app:headerType="titled"
		app:isScreenTitled="false"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:paddingStart="@dimen/default_screen_padding"
		android:paddingEnd="@dimen/default_screen_padding"
		android:paddingBottom="@dimen/default_screen_padding"

		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/header">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:showDividers="middle"
			android:divider="@drawable/divider_default" >

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/create_account"
				android:textSize="28sp"
				android:textStyle="bold" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/input_your_data" />


			<com.unnebulous.consultapronta.views.UserTypeSelectorView
				android:id="@+id/user_type_switch"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center_horizontal" />

			<com.unnebulous.consultapronta.views.ProfilePictureView
				android:id="@+id/profile_picture_input"

				android:layout_width="90dp"
				android:layout_height="90dp"
				android:layout_gravity="center_horizontal"

				app:isInput="true" />

			<EditText
				android:id="@+id/name_input"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:autofillHints="name"
				android:background="@drawable/shape_input"
				android:drawableStart="@drawable/ic_person"
				android:drawablePadding="10dp"
				android:hint="@string/input_name"
				android:inputType="text"

				android:textColor="@color/textLight"
				android:textColorHint="@color/textLight60" />

			<!-- Verificar autofillhint de CPF -->
			<EditText
				android:id="@+id/cpf_input"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:autofillHints=""
				android:background="@drawable/shape_input"
				android:drawableStart="@drawable/ic_document"
				android:drawablePadding="10dp"
				android:hint="@string/input_cpf"
				android:inputType="number"
				android:maxLength="14"

				android:textColor="@color/textLight"
				android:textColorHint="@color/textLight60" />

			<EditText
				android:id="@+id/email_input"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:autofillHints="emailAddress"
				android:background="@drawable/shape_input"
				android:drawableStart="@drawable/ic_email"
				android:drawablePadding="10dp"
				android:hint="@string/input_email"
				android:inputType="textEmailAddress"

				android:textColor="@color/textLight"
				android:textColorHint="@color/textLight60" />

			<EditText
				android:id="@+id/phone_number_input"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:autofillHints="phone"
				android:background="@drawable/shape_input"
				android:drawableStart="@drawable/ic_telephone"
				android:drawablePadding="10dp"
				android:hint="@string/input_phone_number"
				android:inputType="phone"
				android:maxLength="15"

				android:textColor="@color/textLight"
				android:textColorHint="@color/textLight60" />

			<LinearLayout
				android:id="@+id/password_errors_layout"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:visibility="gone"

				tools:visibility="visible" >
				<TextView
					android:id="@+id/password_error_length"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="@color/error"
					android:text="@string/password_length_error"
					android:drawablePadding="@dimen/default_drawable_icon_padding"

					app:drawableStartCompat="@drawable/ic_error_circle"
					app:drawableTint="@color/error" />

				<TextView
					android:id="@+id/password_error_caps"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="@color/error"
					android:text="@string/password_caps_error"
					android:drawablePadding="@dimen/default_drawable_icon_padding"

					app:drawableStartCompat="@drawable/ic_error_circle"
					app:drawableTint="@color/error" />

				<TextView
					android:id="@+id/password_error_numbers"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="@color/error"
					android:text="@string/password_numbers_error"
					android:drawablePadding="@dimen/default_drawable_icon_padding"

					app:drawableStartCompat="@drawable/ic_error_circle"
					app:drawableTint="@color/error" />
			</LinearLayout>

			<EditText
				android:id="@+id/password_input"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:autofillHints="password"
				android:background="@drawable/shape_input"
				android:drawableStart="@drawable/ic_password_lock"
				android:maxLength="4096"
				android:drawablePadding="10dp"
				android:hint="@string/input_password"
				android:inputType="textPassword"
				android:textColor="@color/textLight"
				android:textColorHint="@color/textLight60" />

			<EditText
				android:id="@+id/confirm_password_input"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:autofillHints="password"
				android:background="@drawable/shape_input"
				android:drawableStart="@drawable/ic_password_lock"
				android:drawablePadding="10dp"
				android:hint="@string/input_password_confirm"
				android:inputType="textPassword"

				android:textColor="@color/textLight"
				android:textColorHint="@color/textLight60" />

			<!-- ==== START PATIENT-ONLY INPUTS ==== -->
			<LinearLayout
				android:id="@+id/patient_data_inputs"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal">
				<EditText
					android:id="@+id/weight_input"

					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:background="@drawable/shape_input"
					android:drawableStart="@drawable/ic_weight"
					android:drawablePadding="10dp"
					android:drawableTint="@color/textLight"
					android:hint="@string/weight"
					android:inputType="numberDecimal"
					android:textColor="@color/textLight"
					android:textColorHint="@color/textLight60"
					android:layout_weight="1" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/kilograms"
					android:layout_marginHorizontal="@dimen/list_items_spacing"/>

				<EditText
					android:id="@+id/height_input"

					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:background="@drawable/shape_input"
					android:drawableStart="@drawable/ic_height"
					android:drawablePadding="10dp"
					android:drawableTint="@color/textLight"
					android:hint="@string/height"
					android:inputType="number"
					android:textColor="@color/textLight"
					android:textColorHint="@color/textLight60"
					android:layout_weight="1" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/centimeters"
					android:layout_marginStart="@dimen/list_items_spacing"/>
			</LinearLayout>

			<com.google.android.material.textfield.TextInputLayout
				style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

				android:id="@+id/bloodtype_inputlayout"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textColorHint="@color/textLight"

				app:boxBackgroundColor="@color/primary"
				app:boxCornerRadiusBottomEnd="12dp"
				app:boxCornerRadiusBottomStart="12dp"
				app:boxCornerRadiusTopEnd="12dp"
				app:boxCornerRadiusTopStart="12dp"
				app:counterOverflowTextColor="@color/textLight"
				app:counterTextColor="@color/textLight"
				app:endIconDrawable="@drawable/ic_arrow_down"
				app:endIconMode="custom"
				app:endIconTint="@color/primaryLight"
				app:startIconDrawable="@drawable/ic_bloodtype"
				app:startIconTint="@color/textLight"
				app:hintEnabled="false">

				<com.google.android.material.textfield.MaterialAutoCompleteTextView
					android:id="@+id/bloodtype_input"

					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:hint="@string/bloodtype"
					android:inputType="none"
					android:padding="@dimen/default_card_padding"
					android:textColor="@color/textLight"
					android:textColorHint="@color/textLight60" />

			</com.google.android.material.textfield.TextInputLayout>
			<!-- ==== END PATIENT-ONLY INPUTS ==== -->

			<!-- ==== START PROFESSIONAL-ONLY INPUTS ==== -->
			<LinearLayout
				android:id="@+id/professional_crm_inputs"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:divider="@drawable/divider_list"
				android:showDividers="middle"
				android:visibility="gone"

				tools:visibility="visible">
				<EditText
					android:id="@+id/crm_input"

					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:background="@drawable/shape_input"
					android:drawableStart="@drawable/ic_crm"
					android:drawablePadding="10dp"
					android:drawableTint="@color/textLight"
					android:hint="@string/crm"
					android:inputType="number"
					android:layout_weight="2.5"
					android:textColor="@color/textLight"
					android:textColorHint="@color/textLight60" />

				<com.google.android.material.textfield.TextInputLayout
					style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

					android:id="@+id/crm_uf_inputlayout"

					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:textColorHint="@color/textLight"
					android:layout_weight="1"

					app:boxBackgroundColor="@color/primary"
					app:boxCornerRadiusBottomEnd="12dp"
					app:boxCornerRadiusBottomStart="12dp"
					app:boxCornerRadiusTopEnd="12dp"
					app:boxCornerRadiusTopStart="12dp"
					app:counterOverflowTextColor="@color/textLight"
					app:counterTextColor="@color/textLight"
					app:endIconDrawable="@drawable/ic_arrow_down"
					app:endIconMode="custom"
					app:endIconTint="@color/primaryLight"
					app:hintEnabled="false">

					<com.google.android.material.textfield.MaterialAutoCompleteTextView
						android:id="@+id/crm_uf_input"

						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:hint="@string/uf"
						android:inputType="none"
						android:padding="@dimen/default_card_padding"
						android:textColor="@color/textLight"
						android:textColorHint="@color/textLight60" />

				</com.google.android.material.textfield.TextInputLayout>
			</LinearLayout>

			<EditText
				android:id="@+id/place_action_input"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:autofillHints="postalAddress"
				android:background="@drawable/shape_input"
				android:drawableStart="@drawable/ic_local_hospital"
				android:drawablePadding="10dp"
				android:drawableTint="@color/textLight"
				android:hint="@string/place_action"
				android:inputType="text"
				android:textColor="@color/textLight"
				android:textColorHint="@color/textLight60"
				android:visibility="gone"

				tools:visibility="visible"/>
			<!-- ==== END PROFESSIONAL-ONLY INPUTS ==== -->

			<Button
				android:id="@+id/create_account_button"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/create_account"
				android:textColor="@color/primaryDark"
				android:insetBottom="0dp"

				app:backgroundTint="@color/accent"
				app:cornerRadius="@dimen/big_button_corner_radius" />

			<!-- NOT AVAILABLE BY NOW -->
			<Button
				android:id="@+id/login_govbr_button"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center_horizontal"
				android:text="@string/enter_with_govbr"
				android:textColor="@color/govbr_blue"
				android:visibility="gone"

				app:backgroundTint="@color/white"
				app:icon="@drawable/ic_govbr_negativo"
				app:iconGravity="textEnd"
				app:iconSize="0dp"
				app:iconTint="@color/govbr_blue" />

			<!-- linha do checkbox -->
			<!-- NOT AVAILABLE BY NOW (or never) -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:orientation="horizontal"
				android:visibility="gone">

				<CheckBox
					android:id="@+id/terms_checkbox"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"

					app:buttonTint="@color/textLight"
					app:buttonIconTint="@color/light_checkbox_color" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/terms_part1"
					android:textSize="12sp" />

				<Button
					style="@style/Widget.Material3.Button.TextButton"

					android:id="@+id/use_terms_button"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingLeft="5dp"
					android:paddingTop="0dp"
					android:paddingRight="5dp"
					android:paddingBottom="0dp"
					android:text="@string/terms_of_use"
					android:textColor="@color/accent"
					android:textSize="12sp" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/terms_part2"
					android:textSize="12sp" />

				<Button
					style="@style/Widget.Material3.Button.TextButton"

					android:id="@+id/privacy_policy_button"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingLeft="5dp"
					android:paddingTop="0dp"
					android:paddingRight="5dp"
					android:paddingBottom="0dp"
					android:text="@string/privacy_policy"
					android:textColor="@color/accent"
					android:textSize="12sp" />

			</LinearLayout>

			<!-- linha do já possui conta -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:orientation="horizontal">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/has_account" />

				<Button
					style="@style/Widget.Material3.Button.TextButton"

					android:id="@+id/sign_in_button"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingLeft="5dp"
					android:paddingTop="0dp"
					android:paddingRight="5dp"
					android:paddingBottom="0dp"
					android:text="@string/sign_in"
					android:textColor="@color/accent" />

			</LinearLayout>

		</LinearLayout>

	</ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>