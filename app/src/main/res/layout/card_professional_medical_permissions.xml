<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"

	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/shape_rounded_background"
	android:paddingBottom="@dimen/default_card_padding"
	android:backgroundTint="@color/surface">

	<LinearLayout
		android:id="@+id/status_permission_header"

		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="@dimen/default_card_padding"
		android:background="@drawable/shape_top_rounded_background"
		android:backgroundTint="@color/success"
		android:layout_marginBottom="@dimen/list_items_spacing">
		<TextView
			android:id="@+id/status_permission"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/textDark"

			tools:text="@tools:sample/lorem[1]"/>
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingHorizontal="@dimen/default_card_padding"
		android:orientation="vertical">
		<TextView
			android:id="@+id/professional_name"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/textDark"
			android:textStyle="bold"

			tools:text="@tools:sample/full_names" />

		<TextView
			android:id="@+id/professional_crm"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textSize="14sp"
			android:textColor="@color/textDark"
			android:layout_marginBottom="@dimen/default_inner_elements_spacing"

			tools:text="@tools:sample/date/ddmmyy" />

		<TextView
			android:id="@+id/professional_phone_number"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/textDark"
			android:textSize="14sp"
			android:gravity="center_vertical"
			android:drawablePadding="@dimen/list_items_spacing"

			app:drawableStartCompat="@drawable/ic_telephone"
			app:drawableTint="@color/textDark"

			tools:text="@tools:sample/us_phones" />

		<TextView
			android:id="@+id/professional_email"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/textDark"
			android:textSize="14sp"
			android:gravity="center_vertical"
			android:drawablePadding="@dimen/list_items_spacing"

			app:drawableStartCompat="@drawable/ic_email"
			app:drawableTint="@color/textDark"

			tools:text="@tools:sample/lorem[2]" />

		<TextView
			android:id="@+id/professional_place_action"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/textDark"
			android:textSize="14sp"
			android:gravity="center_vertical"
			android:drawablePadding="@dimen/list_items_spacing"
			android:layout_marginBottom="@dimen/default_inner_elements_spacing"

			app:drawableTint="@color/textDark"
			app:drawableStartCompat="@drawable/ic_local_hospital"

			tools:text="@tools:sample/cities" />

		<TextView
			android:id="@+id/active_permissions_count"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/textDark"
			android:textSize="14sp"
			android:layout_marginBottom="@dimen/list_items_spacing"

			tools:text="@tools:sample/lorem"/>

		<Button
			android:id="@+id/change_permissions_button"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/manage_permissions"
			android:textColor="@color/textDark"
			android:insetBottom="0dp"
			android:insetTop="0dp"

			app:icon="@drawable/ic_lock_open"
			app:iconGravity="textStart"
			app:iconTint="@color/textDark"
			app:iconSize="20dp"
			app:backgroundTint="@color/primaryLight"
			app:cornerRadius="@dimen/big_button_corner_radius" />
	</LinearLayout>

</LinearLayout>