<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"

	android:layout_width="match_parent"
	android:layout_height="match_parent"

	tools:context=".Home">

	<TextView
		android:id="@+id/quick_title"

		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/quick_text"
		android:textSize="20sp"

		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent"/>

	<GridLayout
		android:id="@+id/quick_grid"

		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:columnCount="2"
		android:rowCount="2"
		android:layout_marginTop="@dimen/default_inner_elements_spacing"

		app:layout_constraintTop_toBottomOf="@id/quick_title"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent">

		<LinearLayout
			android:id="@+id/first_button"

			android:layout_width="0dp"
			android:layout_height="150dp"
			android:layout_columnWeight="1"
			android:layout_margin="8dp"
			android:orientation="vertical"
			android:gravity="center"
			android:background="@drawable/grid_background"
			android:clickable="true"
			android:focusable="true" >

			<ImageView
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:src="@drawable/ic_reports"

				app:tint="@color/white" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:text="@string/reports_text"
				android:textSize="16sp" />

		</LinearLayout>

		<LinearLayout
			android:id="@+id/second_button"

			android:layout_width="0dp"
			android:layout_height="150dp"
			android:layout_columnWeight="1"
			android:layout_margin="8dp"
			android:orientation="vertical"
			android:gravity="center"
			android:background="@drawable/grid_background"
			android:clickable="true"
			android:focusable="true" >

			<ImageView
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:src="@drawable/ic_exams"

				app:tint="@color/white" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:text="@string/my_exams_text"
				android:textSize="16sp" />

		</LinearLayout>

		<LinearLayout
			android:id="@+id/third_button"

			android:layout_width="0dp"
			android:layout_height="150dp"
			android:layout_columnWeight="1"
			android:layout_margin="8dp"
			android:orientation="vertical"
			android:gravity="center"
			android:background="@drawable/grid_background"
			android:clickable="true"
			android:focusable="true" >

			<ImageView
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:src="@drawable/ic_medicine"

				app:tint="@color/white" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:text="@string/my_medicines_text"
				android:textSize="16sp" />

		</LinearLayout>

		<LinearLayout
			android:id="@+id/fourth_button"

			android:layout_width="0dp"
			android:layout_height="150dp"
			android:layout_columnWeight="1"
			android:layout_margin="8dp"
			android:orientation="vertical"
			android:gravity="center"
			android:background="@drawable/grid_background"
			android:clickable="true"
			android:focusable="true" >

			<ImageView
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:src="@drawable/ic_appointment"

				app:tint="@color/white" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:text="@string/appointments_text"
				android:textSize="16sp" />

		</LinearLayout>

	</GridLayout>

	<TextView
		android:id="@+id/recents_title"

		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/recent_symptoms"
		android:textSize="20sp"

		app:layout_constraintTop_toBottomOf="@+id/quick_grid"
		app:layout_constraintBottom_toBottomOf="@+id/see_all_button"
		app:layout_constraintStart_toStartOf="parent" />

	<Button
		style="@style/Widget.Material3.Button.TextButton"

		android:id="@+id/see_all_button"

		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingTop="0dp"
		android:paddingBottom="0dp"
		android:paddingRight="5dp"
		android:paddingLeft="5dp"
		android:text="@string/see_all"
		android:textColor="@color/accent"

		app:layout_constraintTop_toBottomOf="@+id/quick_grid"
		app:layout_constraintEnd_toEndOf="parent"
		app:icon="@drawable/ic_arrow_forward"
		app:iconGravity="end"
		app:iconTint="@color/accent" />

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/recents_recycler"

		android:layout_width="0dp"
		android:layout_height="0dp"
		android:layout_marginTop="10dp"
		android:clipToPadding="false"

		app:layout_constraintTop_toBottomOf="@id/recents_title"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>