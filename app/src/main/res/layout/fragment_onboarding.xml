<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"

	android:layout_width="match_parent"
	android:layout_height="match_parent"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	tools:context=".Onboarding">

	<LinearLayout
		android:id="@+id/logo_and_text"

		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:gravity="center"

		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintBottom_toTopOf="@id/sign_in_button">

		<ImageView
			android:id="@+id/logo"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:src="@drawable/ic_logo" />

		<TextView
			android:id="@+id/organize"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/goal_organize"
			android:textStyle="bold"
			android:textSize="23sp"
			android:textColor="@color/surface"
			android:layout_marginTop="15dp"
			/>

		<TextView
			android:id="@+id/agilize"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/goal_agilize"
			android:textStyle="bold"
			android:textSize="23sp"
			android:textColor="@color/surface" />

	</LinearLayout>

	<Button
		style="@style/Widget.Material3.Button.TextButton"

		android:id="@+id/sign_in_button"

		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingLeft="5dp"
		android:paddingTop="0dp"
		android:paddingRight="5dp"
		android:paddingBottom="0dp"
		android:text="@string/own_account"
		android:textColor="@color/accent"

		app:layout_constraintBottom_toTopOf="@id/start"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent"/>

	<Button
		android:id="@+id/start"

		android:layout_width="250dp"
		android:layout_height="wrap_content"
		android:paddingLeft="5dp"
		android:paddingTop="0dp"
		android:paddingRight="5dp"
		android:paddingBottom="0dp"
		android:text="@string/start"
		android:textColor="@color/textDark"
		android:background="@drawable/shape_rounded_background"
		app:backgroundTint="@color/accent"

		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>