<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"

	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:paddingStart="@dimen/default_header_side_padding"
	android:paddingEnd="@dimen/default_header_side_padding"
	android:background="@color/primary"
	android:elevation="50dp" >

	<com.unnebulous.consultapronta.views.ProfilePictureView
		android:id="@+id/header_profile_view"

		android:layout_width="34dp"
		android:layout_height="34dp"

		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent" />

	<ImageView
		android:layout_width="158dp"
		android:layout_height="wrap_content"
		android:src="@drawable/consultapronta_logo_text"
		android:contentDescription="@null"
		android:importantForAccessibility="no"

		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent"/>

	<Button
		style="?attr/materialIconButtonStyle"

		android:id="@+id/notification_button"

		android:layout_width="wrap_content"
		android:layout_height="wrap_content"

		app:icon="@drawable/ic_notification"
		app:iconSize="24dp"
		app:iconTint="@color/textLight"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>