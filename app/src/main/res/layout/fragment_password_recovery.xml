<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"

	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:showDividers="middle"
	android:divider="@drawable/divider_default"

	tools:context=".PasswordRecovery">

	<com.unnebulous.consultapronta.views.HeaderView
		android:id="@+id/header"

		android:layout_width="match_parent"
		android:layout_height="wrap_content"

		app:headerType="titled"
		app:isScreenTitled="false"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:showDividers="middle"
		android:divider="@drawable/divider_default"
		android:paddingHorizontal="@dimen/default_screen_padding">
		<TextView
			android:id="@+id/type_email_label"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/textLight"
			android:text="@string/type_email_password_recovery" />

		<EditText
			android:id="@+id/email_input"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/shape_input"
			android:textColor="@color/textLight"
			android:textColorHint="@color/textLight60"
			android:drawableStart="@drawable/ic_email"
			android:drawableTint="@color/textLight"
			android:hint="@string/input_email"
			android:drawablePadding="@dimen/default_drawable_icon_padding"
			android:inputType="textEmailAddress"
			android:autofillHints="emailAddress" />

		<TextView
			android:id="@+id/open_email_label"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/open_email_password_recovery"
			android:visibility="gone"

			tools:visibility="visible"/>

		<TextView
			android:id="@+id/goto_login_label"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/go_to_login_password_recovery"
			android:visibility="gone"

			tools:visibility="visible" />

		<Button
			android:id="@+id/recover_email_button"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/send"
			android:textColor="@color/primaryDark"
			android:insetBottom="0dp"

			app:backgroundTint="@color/accent"
			app:cornerRadius="@dimen/big_button_corner_radius" />
	</LinearLayout>

</LinearLayout>