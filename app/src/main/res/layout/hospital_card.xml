<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	xmlns:tools="http://schemas.android.com/tools"
	android:orientation="vertical"
	android:background="@drawable/rounded_background"
	android:backgroundTint="@color/surface"
	android:showDividers="middle"
	android:divider="@drawable/divider_default"
	android:layout_marginBottom="16dp">

	<ImageView
		android:layout_width="match_parent"
		android:layout_height="150dp"
		android:contentDescription="@string/hospital_img_placeholder"
		android:src="@drawable/bellover"
		/>

	<GridLayout
		android:id="@+id/info_grid"

		android:layout_width="match_parent"
		android:layout_height="wrap_content"

		android:columnCount="2"
		android:rowCount="3"
		android:padding="@dimen/default_card_padding"
		android:alignmentMode="alignMargins"
		android:useDefaultMargins="false">

		<TextView
			android:id="@+id/hopital_name"

			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:textColor="@color/textDark"
			android:textStyle="bold"
			android:textSize="20sp"

			android:layout_row="0"
			android:layout_column="0"
			android:layout_columnWeight="3"

			tools:text="@string/placeholder" />

		<RatingBar
			android:id="@+id/hospital_rating"

			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:textColor="@color/textDark"
			android:gravity="end"

			android:numStars="5"
			android:max="5"
			android:stepSize="0.5"
			style="?android:attr/ratingBarStyleSmall"

			android:layout_row="0"
			android:layout_column="1"
			android:layout_columnWeight="1"
			/>

		<TextView
			android:id="@+id/hospital_location"

			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:textColor="@color/textDark"
			android:textSize="16sp"
			android:maxLines="2"
			android:ellipsize="end"

			android:layout_row="1"
			android:layout_column="0"
			android:layout_columnWeight="3"

			tools:text="@string/very_long_placeholder" />

		<TextView
			android:id="@+id/hospital_distance"

			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:gravity="end"
			android:textColor="@color/textDark"
			android:background="@drawable/distance_box_background"
			android:textAlignment="center"

			android:layout_row="1"
			android:layout_column="1"
			android:layout_columnWeight="1"

			tools:text="@string/distance_placeholder" />

		<TextView
			android:id="@+id/open"

			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:textColor="@color/success"

			android:layout_row="2"
			android:layout_column="0"
			android:layout_columnWeight="3"

			android:text="@string/hospital_open" />

		<TextView
			android:id="@+id/hospital_occupancy"

			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:gravity="end"
			android:textColor="@color/textDark"
			android:background="@drawable/distance_box_background"

			android:layout_row="2"
			android:layout_column="1"
			android:layout_columnWeight="1"

			tools:text="@string/occupancy_placeholder" />


	</GridLayout>

</LinearLayout>