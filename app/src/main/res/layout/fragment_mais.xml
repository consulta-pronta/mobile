<?xml version="1.0" encoding="utf-8"?>
<ScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"

	android:layout_width="match_parent"
	android:layout_height="match_parent"

	tools:context=".Mais">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:showDividers="middle"
		android:divider="@drawable/divider_default"
		android:gravity="center_horizontal" >

		<androidx.constraintlayout.widget.ConstraintLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/shape_rounded_background"
			android:backgroundTint="@color/surface"
			android:padding="@dimen/default_card_padding" >

			<com.unnebulous.consultapronta.views.ProfilePictureView
				android:id="@+id/profile_picture"

				android:layout_width="90dp"
				android:layout_height="90dp"

				app:layout_constraintTop_toTopOf="parent"
				app:layout_constraintStart_toStartOf="parent" />

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_marginStart="10dp"

				app:layout_constraintTop_toTopOf="@id/profile_picture"
				app:layout_constraintBottom_toBottomOf="@id/profile_picture"
				app:layout_constraintStart_toEndOf="@id/profile_picture" >
				<TextView
					android:id="@+id/user_name"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="@color/textDark"
					android:textStyle="bold"
					android:textSize="20sp"

					tools:text="@string/placeholder" />

				<TextView
					android:id="@+id/user_email"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="@color/textDark"
					android:textSize="14sp"

					tools:text="@string/placeholder" />

				<TextView
					android:id="@+id/user_phone_number"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="@color/textDark"
					android:textSize="14sp"

					tools:text="@string/placeholder" />
			</LinearLayout>

			<com.unnebulous.consultapronta.views.OptionItemView
				android:id="@+id/view_profile_button"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/default_inner_elements_spacing"

				app:text="@string/view_profile"
				app:iconSrc="@drawable/ic_person"
				app:layout_constraintTop_toBottomOf="@id/profile_picture"
				app:layout_constraintStart_toStartOf="parent" />

			<com.unnebulous.consultapronta.views.OptionItemView
				android:id="@+id/edit_profile_button"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"

				app:text="@string/edit_profile"
				app:iconSrc="@drawable/ic_edit_square"
				app:layout_constraintTop_toBottomOf="@id/view_profile_button"
				app:layout_constraintStart_toStartOf="parent" />

		</androidx.constraintlayout.widget.ConstraintLayout>

		<LinearLayout
			android:id="@+id/user_config_list"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="@dimen/default_card_padding"
			android:background="@drawable/shape_rounded_background"
			android:backgroundTint="@color/surface"
			android:showDividers="middle"
			android:divider="@drawable/divider_options_list"
			android:dividerPadding="2dp" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="@dimen/default_card_padding"
			android:background="@drawable/shape_rounded_background"
			android:backgroundTint="@color/surface"
			android:showDividers="middle"
			android:divider="@drawable/divider_options_list"
			android:dividerPadding="2dp" >

			<com.unnebulous.consultapronta.views.OptionItemView
				android:id="@+id/seetings_button"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"

				app:text="@string/settings"
				app:iconSrc="@drawable/ic_cog" />

			<com.unnebulous.consultapronta.views.OptionItemView
				android:id="@+id/privacy_policy_button"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"

				app:text="@string/privacy_policy"
				app:iconSrc="@drawable/ic_shield_person" />

			<com.unnebulous.consultapronta.views.OptionItemView
				android:id="@+id/terms_of_use_button"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"

				app:text="@string/terms_of_use"
				app:iconSrc="@drawable/ic_password_lock" />

			<com.unnebulous.consultapronta.views.OptionItemView
				android:id="@+id/help_and_suppor_button"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"

				app:text="@string/help_and_support"
				app:iconSrc="@drawable/ic_group" />

			<com.unnebulous.consultapronta.views.OptionItemView
				android:id="@+id/about_us_button"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"

				app:text="@string/about_us"
				app:iconSrc="@drawable/ic_info" />

		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="@dimen/default_card_padding"
			android:background="@drawable/shape_rounded_background"
			android:backgroundTint="@color/surface"
			android:showDividers="middle"
			android:divider="@drawable/divider_options_list"
			android:dividerPadding="2dp" >

			<com.unnebulous.consultapronta.views.OptionItemView
				android:id="@+id/clean_cache_button"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"

				app:text="@string/clean_cache"
				app:iconSrc="@drawable/ic_bin" />

			<com.unnebulous.consultapronta.views.OptionItemView
				android:id="@+id/delete_account_button"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"

				app:text="@string/delete_account"
				app:iconSrc="@drawable/ic_bin"
				app:color="@color/error" />

			<com.unnebulous.consultapronta.views.OptionItemView
				android:id="@+id/exit_account_button"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"

				app:text="@string/exit_account"
				app:iconSrc="@drawable/ic_logout"
				app:color="@color/error" />
		</LinearLayout>

		<TextView
			android:id="@+id/last_time_syncronized"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"

			tools:text="@string/placeholder" />

	</LinearLayout>

</ScrollView>