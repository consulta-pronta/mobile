<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout

	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"

	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/shape_rounded_background"
	android:backgroundTint="@color/surface"
	android:padding="@dimen/default_card_padding"
	>

	<ImageView
		android:id="@+id/exam_icon"

		android:layout_width="44dp"
		android:layout_height="44dp"
		android:src="@drawable/ic_info"

		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent"
		app:tint="@color/primaryDark" />

		<TextView
			android:id="@+id/exam_info"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/placeholder"
			android:textColor="@color/textDark"
			android:textStyle="bold"
			app:layout_constraintStart_toEndOf="@id/exam_icon"
			app:layout_constraintTop_toTopOf="parent"
		/>

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:orientation="horizontal"

			app:layout_constraintStart_toEndOf="@id/exam_icon"
			app:layout_constraintTop_toBottomOf="@id/exam_info">

			<TextView
				android:id="@+id/exam_hospital"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/placeholder"
				android:textColor="@color/primary"
				/>

			<Space
				android:layout_width="10dp"
				android:layout_height="10dp"
				android:background="@drawable/shape_circle_accent"
				android:backgroundTint="@color/primaryDark"/>

			<TextView
				android:id="@+id/exam_date"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/date_hint"
				android:textColor="@color/primary"
				/>
		</LinearLayout>

	<ImageButton
		android:id="@+id/view_more"

		android:layout_width="44dp"
		android:layout_height="44dp"
		android:padding="10dp"
		android:src="@drawable/ic_arrow_down"
		android:background="@drawable/shape_circular_button"

		app:tint="@color/white"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<GridLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:columnCount="2"
		android:rowCount="2"
		android:layout_marginTop="@dimen/default_card_padding"
		android:visibility="gone"

		app:layout_constraintTop_toBottomOf="@id/exam_icon"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent"

		tools:visibility="visible">

		<TextView
			android:id="@+id/result_text"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/result_text"
			android:textColor="@color/textDark"
			android:textStyle="bold"
			/>

		<TextView
			android:id="@+id/exam_state"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/placeholder"
			android:textColor="@color/primary"
			android:layout_column="0"
			/>

		<ImageView
			android:id="@+id/exam_state_icon"

			android:layout_width="44dp"
			android:layout_height="44dp"
			android:src="@drawable/ic_info"
			android:layout_columnWeight="3"
			android:layout_row="0"
			android:layout_rowSpan="2"
			android:layout_gravity="end"

			app:tint="@color/success" />

	</GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>