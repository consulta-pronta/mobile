<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout

	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"

	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/shape_rounded_background"
	android:backgroundTint="@color/surface"
	android:padding="@dimen/default_card_padding"
	android:clipChildren="false"
	android:clipToPadding="false">

	<ImageView
		android:id="@+id/exam_icon"

		android:layout_width="44dp"
		android:layout_height="44dp"
		android:src="@drawable/ic_info"

		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent"
		app:tint="@color/primaryDark" />

	<ImageView
		android:id="@+id/exam_state_icon"

		android:layout_width="20dp"
		android:layout_height="20dp"
		android:background="@drawable/shape_circular_button"
		android:backgroundTint="@color/accent"
		android:src="@drawable/ic_info"

		app:layout_constraintEnd_toEndOf="@+id/exam_icon"
		app:layout_constraintBottom_toBottomOf="@+id/exam_icon"
		app:tint="@color/primaryDark" />

	<LinearLayout
		android:id="@+id/exam_main"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:orientation="vertical"

		app:layout_constraintTop_toTopOf="@id/exam_icon"
		app:layout_constraintStart_toEndOf="@id/exam_icon"
		app:layout_constraintEnd_toStartOf="@id/view_more"
		android:layout_marginStart="@dimen/default_drawable_icon_padding"
		android:layout_marginEnd="@dimen/default_drawable_icon_padding" >

		<TextView
			android:id="@+id/exam_info"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/placeholder"
			android:textColor="@color/textDark"
			android:textStyle="bold"
			app:layout_constraintStart_toEndOf="@id/exam_icon"
			app:layout_constraintTop_toTopOf="@+id/exam_icon" />


		<TextView
			android:id="@+id/exam_state"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/placeholder"
			android:textColor="@color/primary" />
	</LinearLayout>


	<ImageButton
		android:id="@+id/view_more"

		android:layout_width="48dp"
		android:layout_height="48dp"
		android:background="@null"
		android:padding="10dp"

		android:rotation="0"
		android:src="@drawable/ic_arrow_down"
		app:layout_constraintBottom_toBottomOf="@+id/exam_icon"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toTopOf="@+id/exam_icon"
		app:tint="@color/primaryDark" />

	<LinearLayout
		android:id="@+id/exam_details"

		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:visibility="gone"

		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@+id/exam_main"
		android:layout_marginTop="@dimen/default_inner_elements_spacing"
>

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="horizontal">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/exam_card_category_label"
				android:textColor="@color/textDark"
				android:layout_marginEnd="4sp"/>

			<TextView
				android:id="@+id/exam_category"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/placeholder"
				android:textColor="@color/primary" />

		</LinearLayout>

		<TextView
			android:id="@+id/exam_date"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/date_hint"
			android:textColor="@color/primary" />

		<TextView
			android:id="@+id/exam_hospital"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/placeholder"
			android:textColor="@color/primary" />

	</LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>