<?xml version="1.0" encoding="utf-8"?>
<ScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"

	android:layout_width="match_parent"
	android:layout_height="match_parent"

	tools:context=".SymptomRegister">

	<androidx.constraintlayout.widget.ConstraintLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content">

		<ImageButton
			android:id="@+id/return_button"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:src="@drawable/ic_arrow_back"
			android:background="@color/transparent"

			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent"
			/>

		<TextView
			android:id="@+id/title"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/default_screen_padding"
			android:text="@string/title_register_page"
			android:textStyle="bold"
			android:textSize="20sp"

			app:layout_constraintTop_toBottomOf="@id/return_button"
			app:layout_constraintStart_toStartOf="parent"
			/>

		<TextView
			android:id="@+id/question_symptom"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/default_screen_padding"
			android:text="@string/question_symptom"
			android:textSize="14sp"

			app:drawableStartCompat="@drawable/ic_asterisk"
			app:drawableTint="@color/error"
			app:layout_constraintTop_toBottomOf="@id/title"
			app:layout_constraintStart_toStartOf="parent"
			/>

		<EditText
			android:id="@+id/question_symptom_area"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/search_background"
			android:layout_marginTop="@dimen/default_card_padding"
			android:hint="@string/question_symptom_area"
			android:inputType="text"
			android:autofillHints="symptons"

			app:layout_constraintTop_toBottomOf="@id/question_symptom"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintEnd_toEndOf="parent"
			/>

		<TextView
			android:id="@+id/detail_symptom"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/default_screen_padding"
			android:text="@string/question_symptom"
			android:textSize="14sp"

			app:drawableStartCompat="@drawable/ic_asterisk"
			app:drawableTint="@color/error"
			app:layout_constraintTop_toBottomOf="@id/question_symptom_area"
			app:layout_constraintStart_toStartOf="parent"
			/>

		<EditText
			android:id="@+id/detail_symptom_area"

			android:layout_width="match_parent"
			android:layout_height="200dp"
			android:background="@drawable/search_background"
			android:layout_marginTop="@dimen/default_card_padding"
			android:hint="@string/detail_symptom_area"
			android:gravity="start"
			android:inputType="text"
			android:autofillHints="description"

			app:layout_constraintTop_toBottomOf="@id/detail_symptom"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintEnd_toEndOf="parent"
			/>

		<TextView
			android:id="@+id/symptom_event"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/default_card_padding"
			android:text="@string/symptom_event"
			android:textSize="14sp"

			app:drawableStartCompat="@drawable/ic_asterisk"
			app:drawableTint="@color/error"
			app:layout_constraintTop_toBottomOf="@id/detail_symptom_area"
			app:layout_constraintStart_toStartOf="parent"
			/>

		<TextView
			android:id="@+id/date"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/default_card_padding"
			android:text="@string/date_title"
			android:textSize="14sp"

			app:layout_constraintTop_toBottomOf="@+id/symptom_event"
			app:layout_constraintStart_toStartOf="parent"
			/>

		<EditText
			android:id="@+id/date_select"

			android:layout_width="175dp"
			android:layout_height="45dp"
			android:autofillHints="date"
			android:background="@drawable/search_background"
			android:drawableEnd="@drawable/ic_calendar"
			android:drawablePadding="15dp"
			android:drawableTint="@color/primaryDark"
			android:hint="@string/date_hint"
			android:inputType="date"

			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/date" />

		<TextView
			android:id="@+id/time"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/default_card_padding"
			android:text="@string/hour_title"
			android:textSize="14sp"
			android:autofillHints="hour"

			app:layout_constraintTop_toBottomOf="@+id/symptom_event"
			app:layout_constraintStart_toStartOf="@id/time_select"
			/>

		<EditText
			android:id="@+id/time_select"

			android:layout_width="175dp"
			android:layout_height="45dp"
			android:background="@drawable/search_background"
			android:hint="@string/hour_hint"
			android:drawableEnd="@drawable/ic_clock"
			android:drawablePadding="15dp"
			android:drawableTint="@color/primaryDark"
			android:inputType="datetime"

			app:layout_constraintTop_toBottomOf="@id/time"
			app:layout_constraintEnd_toEndOf="parent"
			/>

		<TextView
			android:id="@+id/symptom_body_part"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/default_card_padding"
			android:text="@string/which_body_part"
			android:textSize="14sp"

			app:drawableStartCompat="@drawable/ic_asterisk"
			app:drawableTint="@color/error"
			app:layout_constraintTop_toBottomOf="@id/date_select"
			app:layout_constraintStart_toStartOf="parent"
			/>

		<Spinner
			android:id="@+id/body_part_spinner"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/default_card_padding"

			app:icon="@drawable/ic_location"
			app:iconSize="30dp"

			app:layout_constraintTop_toBottomOf="@id/symptom_body_part"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintEnd_toEndOf="parent"
			/>

		<TextView
			android:id="@+id/symptom_intensity"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/default_card_padding"
			android:text="@string/symptom_intensity"
			android:textSize="14sp"

			app:drawableStartCompat="@drawable/ic_asterisk"
			app:drawableTint="@color/error"
			app:layout_constraintTop_toBottomOf="@id/body_part_spinner"
			app:layout_constraintStart_toStartOf="parent"
			/>

		<com.google.android.material.slider.Slider
			android:id="@+id/intensity_slider"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/default_card_padding"
			android:value="5"
			android:valueFrom="0"
			android:valueTo="10"
			android:stepSize="1"

			app:layout_constraintTop_toBottomOf="@id/symptom_intensity"
			app:layout_constraintStart_toStartOf="parent"
			/>

		<TextView
			android:id="@+id/image"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/default_card_padding"
			android:text="Foto"

			app:layout_constraintTop_toBottomOf="@+id/intensity_slider"
			app:layout_constraintStart_toStartOf="parent"
			/>

		<LinearLayout
			android:id="@+id/image_upload"

			android:layout_width="0dp"
			android:layout_height="92dp"
			android:layout_marginTop="8dp"
			android:background="@drawable/img_upload_area"
			android:clickable="true"
			android:focusable="true"
			android:gravity="center"
			android:orientation="vertical"
			android:padding="8dp"

			app:layout_constraintTop_toBottomOf="@id/image"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintEnd_toEndOf="parent">

			<ImageView
				android:id="@+id/camera_icon"

				android:layout_width="28dp"
				android:layout_height="28dp"
				android:contentDescription="Adicionar imagem"
				android:src="@drawable/ic_camera"
				android:tint="@android:color/white" />

			<TextView
				android:id="@+id/image_upload_text"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="5dp"
				android:text="@string/img_instructions"
				android:textColor="@android:color/white"
				android:textSize="12sp" />

		</LinearLayout>

		<Button
			android:id="@+id/symptom_register"

			android:layout_width="match_parent"
			android:layout_marginTop="@dimen/default_inner_elements_spacing"
			android:layout_height="wrap_content"
			android:text="Registrar Sintoma"
			android:textColor="@color/textDark"
			android:background="@drawable/big_button_shape"
			android:backgroundTint="@color/accent"


			app:layout_constraintTop_toBottomOf="@id/image_upload"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintEnd_toEndOf="parent"
			/>


	</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>