<?xml version="1.0" encoding="utf-8"?>
<ScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"

	android:layout_width="match_parent"
	android:layout_height="match_parent"

	tools:context=".EditProfile">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingBottom="@dimen/default_padding_bottom"
		android:orientation="vertical"
		android:showDividers="middle"
		android:divider="@drawable/divider_default">

		<TextView
			android:id="@+id/user_name"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textSize="24sp"
			android:textStyle="bold"
			android:layout_gravity="center_horizontal"

			app:layout_constraintTop_toTopOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintEnd_toEndOf="parent"

			tools:text="@tools:sample/full_names" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/contact"
			android:textSize="24sp"/>

		<com.unnebulous.consultapronta.views.SelectOptionItemView
			android:id="@+id/email_option"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"

			app:selectOptionType="complete"
			app:textColor="@color/textLight"
			app:completeLayoutIcon="@drawable/ic_email"
			app:selectText="@string/input_email">

			<androidx.appcompat.widget.SwitchCompat
				android:id="@+id/switch_email"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"

				app:switchMinWidth="60dp"
				app:track="@drawable/shape_switch_background"
				app:trackTint="@color/switch_color"
				app:thumbTint="@color/textLight" />
		</com.unnebulous.consultapronta.views.SelectOptionItemView>

		<com.unnebulous.consultapronta.views.SelectOptionItemView
			android:id="@+id/sms_option"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"

			app:selectOptionType="complete"
			app:textColor="@color/textLight"
			app:completeLayoutIcon="@drawable/ic_sms"
			app:selectText="@string/sms_contact_form">

			<androidx.appcompat.widget.SwitchCompat
				android:id="@+id/switch_sms"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"

				app:switchMinWidth="60dp"
				app:track="@drawable/shape_switch_background"
				app:trackTint="@color/switch_color"
				app:thumbTint="@color/textLight" />
		</com.unnebulous.consultapronta.views.SelectOptionItemView>

		<com.unnebulous.consultapronta.views.SelectOptionItemView
			android:id="@+id/whatsapp_option"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"

			app:selectOptionType="complete"
			app:textColor="@color/textLight"
			app:completeLayoutIcon="@drawable/ic_whatsapp_app"
			app:selectText="@string/whatsapp_contact_form"
			app:showIconAsRaw="true">

			<androidx.appcompat.widget.SwitchCompat
				android:id="@+id/switch_whatsapp"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"

				app:switchMinWidth="60dp"
				app:track="@drawable/shape_switch_background"
				app:trackTint="@color/switch_color"
				app:thumbTint="@color/textLight" />
		</com.unnebulous.consultapronta.views.SelectOptionItemView>

		<com.unnebulous.consultapronta.views.SelectOptionItemView
			android:id="@+id/telegram_option"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"

			app:selectOptionType="complete"
			app:textColor="@color/textLight"
			app:completeLayoutIcon="@drawable/ic_telegram_app"
			app:selectText="@string/telegram_contact_form"
			app:showIconAsRaw="true">

			<androidx.appcompat.widget.SwitchCompat
				android:id="@+id/switch_telegram"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"

				app:switchMinWidth="60dp"
				app:track="@drawable/shape_switch_background"
				app:trackTint="@color/switch_color"
				app:thumbTint="@color/textLight" />
		</com.unnebulous.consultapronta.views.SelectOptionItemView>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/personal_data"
			android:textSize="24sp" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/birth_date" />

		<Button
			android:id="@+id/birth_date_input"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:textColor="@color/textDark"
			android:insetTop="0dp"
			android:insetBottom="0dp"
			android:textAlignment="viewStart"

			app:backgroundTint="@color/surface"
			app:cornerRadius="@dimen/big_button_corner_radius"
			app:icon="@drawable/ic_calendar"
			app:iconGravity="start"
			app:iconTint="@color/textDark"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/date" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/gender" />

		<com.google.android.material.textfield.TextInputLayout
			style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

			android:id="@+id/gender_identity_inputlayout"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:textColorHint="@color/textDark"

			app:boxBackgroundColor="@color/surface"
			app:boxCornerRadiusBottomEnd="12dp"
			app:boxCornerRadiusBottomStart="12dp"
			app:boxCornerRadiusTopEnd="12dp"
			app:boxCornerRadiusTopStart="12dp"
			app:counterOverflowTextColor="@color/textDark"
			app:counterTextColor="@color/textDark"
			app:endIconDrawable="@drawable/ic_arrow_down"
			app:endIconMode="custom"
			app:endIconTint="@color/textDark"
			app:startIconDrawable="@drawable/ic_transgender"
			app:startIconTint="@color/textDark"
			app:hintEnabled="false">

			<com.google.android.material.textfield.MaterialAutoCompleteTextView
				android:id="@+id/gender_identity_input"

				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:hint="@string/gender_identity_label"
				android:inputType="textAutoComplete"
				android:padding="@dimen/default_card_padding"
				android:textColor="@color/textDark"
				android:textColorHint="@color/textDark60" />

		</com.google.android.material.textfield.TextInputLayout>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/location" />

		<EditText
			android:id="@+id/address_input"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:autofillHints="postalAddress"
			android:background="@drawable/shape_input"
			android:backgroundTint="@color/surface"
			android:drawableStart="@drawable/ic_location"
			android:drawablePadding="10dp"
			android:drawableTint="@color/textDark"
			android:hint="@string/location_input"
			android:inputType="text"
			android:textColor="@color/textDark"
			android:textColorHint="@color/textDark60" />
	</LinearLayout>
</ScrollView>