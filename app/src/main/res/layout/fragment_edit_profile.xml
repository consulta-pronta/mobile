<?xml version="1.0" encoding="utf-8"?>
<ScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"

	android:layout_width="match_parent"
	android:layout_height="match_parent"

	tools:context=".EditProfile">

	<androidx.constraintlayout.widget.ConstraintLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingBottom="@dimen/default_padding_bottom" >

		<TextView
			android:id="@+id/user_name"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textSize="24sp"
			android:textStyle="bold"
			android:padding="@dimen/default_padding_bottom"

			app:layout_constraintTop_toTopOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintEnd_toEndOf="parent"

			tools:text="@tools:sample/full_names" />

		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/contact_form_area"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingBottom="@dimen/default_padding_bottom"

			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@+id/user_name">

			<TextView
				android:id="@+id/contact_form_area_title"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/contact"
				android:textSize="20sp"

				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent" />

			<com.unnebulous.consultapronta.views.SelectOptionItemView
				android:id="@+id/email_option"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingBottom="@dimen/default_padding_bottom"

				app:selectOptionType="complete"
				app:textColor="@color/textLight"
				app:completeLayoutIcon="@drawable/ic_email"
				app:selectText="@string/input_email"
				app:layout_constraintTop_toBottomOf="@id/contact_form_area_title">

				<androidx.appcompat.widget.SwitchCompat
					android:id="@+id/switch_email"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"

					app:switchMinWidth="60dp"
					app:track="@drawable/shape_switch_background"
					app:trackTint="@color/switch_color"
					app:thumbTint="@color/textLight" />
			</com.unnebulous.consultapronta.views.SelectOptionItemView>

			<com.unnebulous.consultapronta.views.SelectOptionItemView
				android:id="@+id/sms_option"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingBottom="@dimen/default_padding_bottom"

				app:selectOptionType="complete"
				app:textColor="@color/textLight"
				app:completeLayoutIcon="@drawable/ic_sms"
				app:selectText="@string/sms_contact_form"
				app:layout_constraintTop_toBottomOf="@id/email_option">

				<androidx.appcompat.widget.SwitchCompat
					android:id="@+id/switch_sms"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"

					app:switchMinWidth="60dp"
					app:track="@drawable/shape_switch_background"
					app:trackTint="@color/switch_color"
					app:thumbTint="@color/textLight" />
			</com.unnebulous.consultapronta.views.SelectOptionItemView>

			<com.unnebulous.consultapronta.views.SelectOptionItemView
				android:id="@+id/whatsapp_option"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingBottom="@dimen/default_padding_bottom"

				app:selectOptionType="complete"
				app:textColor="@color/textLight"
				app:completeLayoutIcon="@drawable/ic_whatsapp_app"
				app:selectText="@string/whatsapp_contact_form"
				app:showIconAsRaw="true"
				app:layout_constraintTop_toBottomOf="@id/sms_option">

				<androidx.appcompat.widget.SwitchCompat
					android:id="@+id/switch_whatsapp"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"

					app:switchMinWidth="60dp"
					app:track="@drawable/shape_switch_background"
					app:trackTint="@color/switch_color"
					app:thumbTint="@color/textLight" />
			</com.unnebulous.consultapronta.views.SelectOptionItemView>

			<com.unnebulous.consultapronta.views.SelectOptionItemView
				android:id="@+id/telegram_option"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingBottom="@dimen/default_padding_bottom"

				app:selectOptionType="complete"
				app:textColor="@color/textLight"
				app:completeLayoutIcon="@drawable/ic_telegram_app"
				app:selectText="@string/telegram_contact_form"
				app:showIconAsRaw="true"
				app:layout_constraintTop_toBottomOf="@id/whatsapp_option">

				<androidx.appcompat.widget.SwitchCompat
					android:id="@+id/switch_telegram"

					android:layout_width="wrap_content"
					android:layout_height="wrap_content"

					app:switchMinWidth="60dp"
					app:track="@drawable/shape_switch_background"
					app:trackTint="@color/switch_color"
					app:thumbTint="@color/textLight" />
			</com.unnebulous.consultapronta.views.SelectOptionItemView>

		</androidx.constraintlayout.widget.ConstraintLayout>

		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/personal_data_area"

			android:layout_width="match_parent"
			android:layout_height="wrap_content"

			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@+id/contact_form_area">

			<TextView
				android:id="@+id/personal_data_area_title"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/personal_data"
				android:textSize="20sp"

				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent" />

			<TextView
				android:id="@+id/birth_date_label"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/birth_date"

				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/personal_data_area_title"

				/>

			<Button
				android:id="@+id/birth_date_select"

				android:layout_width="match_parent"
				android:layout_height="45dp"
				android:autofillHints="date"
				android:background="@drawable/shape_search_background"
				android:textColor="@color/textDark"
				android:textAlignment="viewStart"
				android:text="@string/placeholder_date"
				android:insetLeft="0dp"

				app:icon="@drawable/ic_calendar"
				app:iconTint="@color/primaryDark"
				app:iconGravity="start"
				app:iconPadding="12dp"
				app:backgroundTint="@color/white"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/birth_date_label" />

			<TextView
				android:id="@+id/gender_label"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/gender"
				android:paddingTop="@dimen/default_padding_bottom"

				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/birth_date_select" />

			<com.google.android.material.textfield.TextInputLayout
				style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

				android:id="@+id/gender_identity_inputlayout"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textColorHint="@color/textDark"

				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/gender_label"

				app:boxBackgroundColor="@color/white"
				app:boxCornerRadiusBottomEnd="12dp"
				app:boxCornerRadiusBottomStart="12dp"
				app:boxCornerRadiusTopEnd="12dp"
				app:boxCornerRadiusTopStart="12dp"
				app:counterOverflowTextColor="@color/textDark"
				app:counterTextColor="@color/textDark"
				app:endIconDrawable="@drawable/ic_arrow_down"
				app:endIconMode="custom"
				app:endIconTint="@color/primaryDark"
				app:startIconDrawable="@drawable/ic_gender"
				app:startIconTint="@color/textDark"
				app:hintEnabled="false">

				<com.google.android.material.textfield.MaterialAutoCompleteTextView
					android:id="@+id/gender_identity_input"

					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:inputType="textAutoComplete"
					android:padding="@dimen/default_card_padding"
					android:textColor="@color/textDark"
					android:textColorHint="@color/textDark"

					tools:hint="@string/placeholder"/>

			</com.google.android.material.textfield.TextInputLayout>

			<TextView
				android:id="@+id/location_label"

				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/location"
				android:paddingTop="@dimen/default_padding_bottom"

				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/gender_identity_inputlayout"

				/>

			<EditText
				android:id="@+id/location_input"

				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@drawable/shape_search_background"
				android:drawableStart="@drawable/ic_location"
				android:drawableTint="@color/primaryDark"
				android:text="@string/placeholder"
				android:drawablePadding="@dimen/default_drawable_icon_padding"

				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/location_label"
				/>
		</androidx.constraintlayout.widget.ConstraintLayout>

	</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>