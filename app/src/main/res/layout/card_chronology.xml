<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"

	android:layout_width="match_parent"
	android:layout_height="wrap_content">

	<FrameLayout
		android:id="@+id/icon_wrapper"

		android:layout_width="40dp"
		android:layout_height="40dp"
		android:padding="8dp"
		android:background="@drawable/shape_circle_accent"
		android:backgroundTint="@color/primary"

		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent">
		<ImageView
			android:id="@+id/icon"

			android:layout_width="match_parent"
			android:layout_height="match_parent"

			app:tint="@color/textLight"

			tools:src="@drawable/ic_graphic" />
	</FrameLayout>

	<ImageView
		android:layout_width="3dp"
		android:layout_height="0dp"
		android:background="@drawable/shape_chronology_rod"
		android:layout_marginVertical="2dp"

		app:layout_constraintTop_toBottomOf="@id/icon_wrapper"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="@id/icon_wrapper"
		app:layout_constraintEnd_toEndOf="@id/icon_wrapper" />

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:background="@drawable/shape_rounded_background"
		android:backgroundTint="@color/surface"
		android:padding="@dimen/default_card_padding"
		android:layout_marginStart="10dp"
		android:layout_marginBottom="10dp"

		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toEndOf="@id/icon_wrapper"
		app:layout_constraintEnd_toEndOf="parent">
		<TextView
			android:id="@+id/title"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/textDark"
			android:textStyle="bold"
			android:textSize="20sp"

			tools:text="@string/placeholder"/>

		<TextView
			android:id="@+id/date"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/textDark"
			android:textSize="20sp"

			tools:text="@string/placeholder"/>

		<TextView
			android:id="@+id/description"

			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="@color/textDark"
			android:layout_marginTop="@dimen/default_inner_elements_spacing"

			tools:text="@string/very_long_placeholder" />
	</LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>